# ---------------------------------------------------------------------------
# SOLAXIUM INTELLIGENCE — environment
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://solaxium:solaxium@127.0.0.1:5432/solaxium?schema=public"

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# "demo"   -> fully local heuristic brain, no network, no API key required.
# "claude" -> Anthropic API, server side only.
AI_PROVIDER="demo"

# Only read on the server. Never expose to the browser, never send to an agent.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# ---------------------------------------------------------------------------
# Solana
# ---------------------------------------------------------------------------
# V1 ships with "simulation" only. "devnet" / "mainnet-beta" are reserved for a
# future release and are intentionally not wired to a signer.
SOLANA_MODE="simulation"
SOLANA_NETWORK="simulation"
SOLANA_RPC_URL=""
